{
  "name": "playwright-interview-project",
  "version": "1.0.0",
  "description": "A simple, beginner-friendly Playwright + TypeScript project covering the concepts asked in automation testing interviews.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:api": "playwright test --project=chromium tests/api",
    "test:public": "playwright test --project=public-demo",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:3000",
    "demo-app": "node demo-app/server.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
