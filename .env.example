# Copy this file to `.env` and adjust values for your environment:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# `.env` is git-ignored, so real credentials never get committed.
# The values below are only the PUBLIC demo accounts of the bundled local
# Practice App — they are safe to share. Never put real secrets in this file.
# If `.env` does not exist, playwright.config.ts falls back to this file.

# Which environment to test: local | staging
TEST_ENV=local

# Overrides the base URL for any environment (optional)
# BASE_URL=http://localhost:3000

# Practice App demo accounts
APP_USERNAME=student
APP_PASSWORD=Password123!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# Optional public demo suite (tests/public) — saucedemo.com public practice account
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
